SERVER_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173

# Local MySQL defaults. For Aiven, use its hostname, port, database and credentials.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=restaurant_orders
DB_USERNAME=restaurant_app
DB_PASSWORD=replace-with-your-database-password
DB_SSL=false

# Generate a random key with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRATION_MINUTES=480

# Optional one-time bootstrap. Set all three together only on an empty users table.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=