# Local backend development only. Replace placeholders and never commit backend/.env.
SPRING_PROFILES_ACTIVE=local
DB_HOST=localhost
DB_PORT=5432
DB_NAME=restaurant
DB_USERNAME=replace-with-local-database-user
DB_PASSWORD=replace-with-local-database-password
DB_SSL_MODE=disable
JWT_SECRET=replace-with-base64-encoded-random-key-of-at-least-32-bytes
JWT_EXPIRATION_MS=900000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
